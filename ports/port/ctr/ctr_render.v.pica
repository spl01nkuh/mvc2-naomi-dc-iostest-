; ctr_render.v.pica  The vertex shader: screen-space vertices with 1/w, multiplied by w for perspective
; texturing; the fixed normal and view let lighting read a texel as a palette index. With tl set, a model's
; own vertices, turned to the screen and lit here

.fvec projection[4]
.fvec tl_unif[7]            ; 0, 1, 3: the model to the clip space's x, y and w; 2: its z from w, as x * w + y in the
                            ; depth slice (no float24 overflow, however narrow the slice); 4: the face's R, G, B, A, over 255
                            ; for vertex colours; 5: the light in the model's space, over the normals' scale, and the
                            ; ambient; 6: u and v scaled to the texture, u * x and 1 + v * y

.bool tl
.bool tl_lit
.bool tl_vtxcol
.bool rcp_w                 ; inpos.w is 1/w, the shader takes its reciprocal

.constf consts(1.0, 0.0, 0.00392156863, 0.0)
.constf nconsts(0.00784313725, -1.0, 0.0, 0.0)  ; a normal's byte b as 2 * b / 255 - 1

.out outpos position
.out outtc0 texcoord0
.out outclr color
.out outquat normalquat
.out outview view

.alias inpos v0             ; x, y in pixels, the depth (0 to 1), w; with tl, the model's x, y, z
.alias intc v1              ; u, v
.alias inclr v2             ; the colour's bytes: B, G, R, A; with tl_lit, the normal's x, y, z

.proc main
    ifu tl
        mov r0.xyz, inpos.xyz
        mov r0.w, consts.x
        dp4 outpos.x, tl_unif[0], r0
        dp4 outpos.y, tl_unif[1], r0
        dp4 r4.x, tl_unif[3], r0
        mov outpos.w, r4.x
        mul r4.y, tl_unif[2].x, r4.x
        add outpos.z, tl_unif[2].y, r4.y
        mul r1, tl_unif[6], intc
        add r1.y, consts.x, r1.y
        mov outtc0, r1
        ifu tl_lit
            mul r2.xyz, nconsts.xxx, inclr.xyz
            add r2.xyz, nconsts.yyy, r2.xyz
            dp3 r2.x, tl_unif[5], r2
            max r2.x, consts.y, r2.x
            add r2.x, tl_unif[5].w, r2.x
            mul r3.xyz, tl_unif[4].xyz, r2.xxx
            mov r3.w, tl_unif[4].w
        .else
            ifu tl_vtxcol
                mul r3, tl_unif[4], inclr.zyxw
            .else
                mov r3, tl_unif[4]
            .end
        .end
        min r3, consts.xxxx, r3
        max r3, consts.yyyy, r3
        mov outclr, r3
    .else
        mov r0.xyz, inpos.xyz
        mov r0.w, consts.x
        dp4 r1.x, projection[0], r0
        dp4 r1.y, projection[1], r0
        dp4 r1.z, projection[2], r0
        dp4 r1.w, projection[3], r0
        mov r2.x, inpos.w
        ifu rcp_w
            rcp r2.x, inpos.w
        .end
        mul outpos, r1, r2.xxxx
        mov outtc0, intc
        mul outclr, consts.zzzz, inclr.zyxw
    .end
    mov outquat, consts.yyyx
    mov outview, consts.yyxy
    end
.end
